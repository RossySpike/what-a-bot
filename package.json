{
  "name": "what-a-bot",
  "version": "1.0.0",
  "description": "A Whatsapp bot that extracts text from images.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch --env-file=.env.dev src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node  --format=esm --packages=external --target=node26 --outdir=dist --drop:console ",
    "start": "node --env-file=.env ./dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
